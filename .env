# Copy to .env and adjust. Docker Compose reads this file.

# --- Postgres (canonical memories + pgvector embeddings) ---
POSTGRES_USER=prl
POSTGRES_PASSWORD=prl
POSTGRES_DB=prl
# Host port (container is always 5432). 5433 avoids clashing with a local Postgres.
POSTGRES_PORT=5433

# --- Neo4j (the Life Graph) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=prlpassword
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Redis (Celery broker / cache) ---
REDIS_PORT=6380

# --- API ---
API_PORT=8000

# --- Embeddings ---
# sentence_transformers = real local transformer encoder, meaning-aware (default)
# local                 = deterministic offline hashing embedder (token-overlap only, fallback)
# openai                = OpenAI embeddings (set OPENAI_API_KEY)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_DIM=384
ST_MODEL=sentence-transformers/all-MiniLM-L6-v2
# OPENAI_API_KEY=
